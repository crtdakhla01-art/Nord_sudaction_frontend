# Copy to .env.local and adjust as needed.
# Restart the Vite dev server after changing these values.

# Local backend (default when unset):
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_IMG=http://localhost:8000/storage

# Production backend (for local testing against live API):
VITE_API_BASE_URL=https://api.nordsudaction.ma/api
VITE_API_BASE_IMG=https://api.nordsudaction.ma/storage
